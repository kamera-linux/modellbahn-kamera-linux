        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Erreichbarkeit per SSH (Statuscheck alle 30 s) und laufende Aufnahmen",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "offline",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "online",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "nimmt auf",
                  "color": "blue",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) (modellbahn_camera_up + modellbahn_camera_recording)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true,
          "instant": false
