# --- Docker Compose -------------------------------------------------------
# Private SSH key on the HOST used to log into the cameras (mounted read-only).
# Recommended: a dedicated key, e.g. ssh-keygen -t ed25519 -f ~/.ssh/kamera_ed25519
SSH_KEY_FILE=/home/USER/.ssh/kamera_ed25519
# Port on the host for the web interface
HOST_PORT=8000
# uid/gid that owns ./config, ./data and the key file (see `id -u`, `id -g`)
APP_UID=1000
APP_GID=1000

# Optional: microphone of this host for sound in the videos (see docker-compose.audio-*.yml)
# COMPOSE_FILE=docker-compose.yml:docker-compose.audio-pulse.yml

# --- Application ----------------------------------------------------------
LOG_LEVEL=info
# Login for the web interface (HTTP Basic Auth). Leave empty to disable – not recommended.
AUTH_USER=admin
AUTH_PASSWORD=
# Optional: allowed cross-origin hosts, comma-separated (normally not needed)
CORS_ORIGINS=
# SSH timeouts in ms (connect / status check)
SSH_TIMEOUT=30000
SSH_STATUS_TIMEOUT=5000
# Host key pinning: tofu (default, pins on first contact) or off
SSH_HOST_KEY_CHECK=tofu
# Microphone: "pulse:<source>" (pactl list sources short) or "alsa:<device>" (arecord -l).
# Empty = no audio.
AUDIO_INPUT=
# Lead time in seconds for "record all" (all cars start at the same moment)
START_LEAD_SECONDS=7
# Directory of camera-capture.py/camera-record.py on the Pis
REMOTE_SCRIPT_DIR=~/modellbahn-kamera-linux/scripts

# For local development without Docker (npm run dev):
# SSH_KEY_PATH=/home/USER/.ssh/kamera_ed25519
